{
  "name": "owl-phone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OWL \u2014 retro QWERTY phone simulator with a working mini-OS",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "docs": "node scripts/make-docs.mjs",
    "test:api": "tsx scripts/api-test.mjs",
    "check": "npm run typecheck && npm run build && npm run smoke && npm run test:api"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "@mozilla/readability": "^0.5.0",
    "idb-keyval": "^6.2.1",
    "jsmediatags": "^3.9.7",
    "linkedom": "^0.18.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  }
}
